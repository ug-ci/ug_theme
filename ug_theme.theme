function ug_theme_preprocess_image(&$variables) {
    // dodaj klasy zdefiniowane w module `ug_image_style_tweak`
    if(function_exists('image_style_custom_css_class_helper')){
        $classes = image_style_custom_css_class_helper($variables['style_name']);
        $variables['attributes']['class'][] = $classes;
    }
}


/**
 * @param $variables
 * @param $hook
 *
 * Wstawia do zmiennej ścieżkę do skórki
 *
 * @return void
 */
function ug_theme_preprocess(&$variables, $hook)
{
  $variables['parent_path'] = \Drupal::service('extension.list.theme')->getPath('ug_faculty');
  $language = \Drupal::languageManager()->getCurrentLanguage()->getId();
  $variables['language'] = $language;
}


