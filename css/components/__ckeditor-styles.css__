
body {
    color: #141414 !important;
    counter-reset: list;
}

.ramka {
    font-size: 1.3rem;
    text-align: left;
    margin: 2rem 0;
    list-style-type: none;
    background-color: #fff;
    border-left: 6px solid var(--color-UG);
    padding: 0.4rem 2.65rem;
}

