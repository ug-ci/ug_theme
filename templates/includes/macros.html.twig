{% macro blok_aktualnosci(tid, show_title = 0, title = 'Aktualności' ) %}
  {% if show_title %}
    <h2>{{ title | t }}</h2>
  {% endif %}
  {{ drupal_view('aktualnosci', 'block_aktualnosci',  tid ) }}
{% endmacro blok_aktualnosci %}


