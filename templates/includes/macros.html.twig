{# Wykorzystywane w: akademiki-budynek #}

{% macro icon_with_address(icon, field_value, list=0) %}
  <div class="d-flex align-items-center mt-1 mb-4">
    <div class="material-icons p-2 fs-3 text-primary align-items-center">{{ icon }}</div>
    <div class="card-text py-2 px-3">
      {% if list==0 %}
        {{ field_value }}
      {% else %}
        {% for item in field_value %}
          <div>{{ item.value }}</div>
        {% endfor %}
      {% endif %}
    </div>
  </div>
{% endmacro icon_with_address %}