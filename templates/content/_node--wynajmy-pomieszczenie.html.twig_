{# ORYGINALNE #}

{#





{%
  set classes = [
    'node',
    'node--type-' ~ node.bundle|clean_class,
    node.isPromoted() ? 'node--promoted',
    node.isSticky() ? 'node--sticky',
    not node.isPublished() ? 'node--unpublished',
    view_mode ? 'node--view-mode-' ~ view_mode|clean_class,
    'clearfix',
  ]
%}
<article{{ attributes.addClass(classes) }}>
  <header>
    {{ title_prefix }}
    {% if label and not page %}
      <h2{{ title_attributes.addClass('node__title') }}>
        <a href="{{ url }}" rel="bookmark">{{ label }}</a>
      </h2>
    {% endif %}
    {{ title_suffix }}

  </header>
  <div{{ content_attributes.addClass('node__content', 'clearfix') }}>
	{% if node.field_schowaj_galerie.value == 1 %}
		{{ content|without('field_zdjecia')|without('field_zdjecie') }}
	{% else %}
		{{ content }}
	{% endif %}
  </div>
  {% if display_submitted %}
  <a class="toggle_record-link">
				<div class="toggle_record">
					<div class="toggle_record-box">
						<div class="toggle_record-box-one toggle_record-box-line"></div>
						<div class="toggle_record-box-two toggle_record-box-line"></div>
					</div>
					<span class="toggle_record-text">Pokaż rejestr zmian</span>
				</div>
	</a>
    <div class="node__meta toggle_record-description">
    <hr/>
      {% block submitted %}
        {% set createdDate = node.getCreatedTime|format_date('long') %}
        {% set changedDate = node.getChangedTime|format_date('long') %}
        {% set author = node.Owner %}
        {% set rev_author = node.getRevisionUser %}
        
	{% set author_field_imie = '@label'|t({'@label': 'Importer'}) %}
        {% set author_field_nazwisko = '@label'|t({'@label': 'Automatyczny'}) %}

        {% if author.field_imie.value and author.field_nazwisko.value %}
	    {% set author_field_imie = author.field_imie.value %}
    	    {% set author_field_nazwisko = author.field_nazwisko.value %}
        {% endif %}

	{% set rev_author_field_imie = '@label'|t({'@label': 'Importer'}) %}
        {% set rev_author_field_nazwisko = '@label'|t({'@label': 'Automatyczny'}) %}

        {% if rev_author.field_imie.value and rev_author.field_nazwisko.value %}
	    {% set rev_author_field_imie = rev_author.field_imie.value %}
    	    {% set rev_author_field_nazwisko = rev_author.field_nazwisko.value %}
        {% endif %}

        <span{{ author_attributes }}>
          {% trans %}Submitted on {{ createdDate }} by {{ author_field_imie }} {{ author_field_nazwisko }} {% endtrans %}
        </span>
        <span{{ author_attributes }}>
          {% trans %}Changed on {{ changedDate }} by {{ rev_author_field_imie }} {{ rev_author_field_nazwisko }}{% endtrans %}
        </span>
      {% endblock %}
      {{ metadata }}
    </div>
  {% endif %}
</article>


#}