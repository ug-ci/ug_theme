{#
/**
 * @file
 * Theme override to display a taxonomy term.
 *
 * Available variables:
 * - url: URL of the current term.
 * - name: Name of the current term.
 * - content: Items for the content of the term (fields and description).
 *   Use 'content' to print them all, or print a subset such as
 *   'content.description'. Use the following code to exclude the
 *   printing of a given child element:
 *   @code
 *   {{ content|without('description') }}
 *   @endcode
 * - attributes: HTML attributes for the wrapper.
 * - page: Flag for the full page state.
 * - term: The taxonomy term entity, including:
 *   - id: The ID of the taxonomy term.
 *   - bundle: Machine name of the current vocabulary.
 * - view_mode: View mode, e.g. 'full', 'teaser', etc.
 *
 * @see template_preprocess_taxonomy_term()
 */
#}
{%
  set classes = [
    'taxonomy-term',
    'vocabulary-' ~ term.bundle|clean_class,
  ]
%}
<div{{ attributes.setAttribute('id', 'taxonomy-term-' ~ term.id).addClass(classes) }}>
  {{ title_prefix }}
  {% if not page %}
    <h2><a href="{{ url }}">{{ name }}</a></h2>
  {% endif %}
  {{ title_suffix }}

  <div class="content">
{#    {{ kint(term) }}#}

{#    {{ content.field_mapa_kampusu }}#}
{#    {{ kint(content.field_mapa_w_pdf.title) }}#}
{#    {{ kint(content.field_mapa_w_pdf.label) }}#}
{#    {{ content.field_mapa_w_pdf }}#}

      {% set descr = term.description.getValue() | first  %}
      {% if descr and descr.value %}

          {% set description = {
              '#type':   'processed_text',
              '#text':    descr.value,
              '#format':  descr.format,
            } %}
        {{ description }}
      {% endif %}


    {{ drupal_contextual_links('entity.view.edit_form:view=mapa_budynki:display_id=block_mapa_by_kampus') }}
    {{ drupal_view('mapa_budynki', 'block_mapa_by_kampus', term.id) }}



    {{ drupal_contextual_links('entity.view.edit_form:view=mapa_budynki:display_id=block_budynki_w_kampusie') }}
      {{ drupal_view('mapa_budynki', 'block_budynki_w_kampusie', term.id) }}
  </div>
</div>
