        <div class="col-md-12 ">
            <section class=" mb-4 rounded-0 hero p-0 bg-light">
                <div class="row py-0 ps-4">
                    <div class="col-md-7 d-flex justify-content-center flex-column py-4">
{#                        <h1 class="display-5">{{ label }}</h1>#}
                        <h1 class="display-5">{{ node.field_kierunek.value }}</h1>
                        <p class="fs-3 text-dark fw-bold">
                            {% if node.langcode.value == 'pl' %}Studia {{ content.field_stopien[0]['#markup'] }}
                            {% else %} {{ content.field_stopien[0]['#markup'] }} Course
                            {% endif %} <br/>
