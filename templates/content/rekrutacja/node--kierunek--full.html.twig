                            <li class=" py-2">
                                <a class="nav-link read_more" href="#1">{{ 'Description' | t }}</a>
                            </li>
                            <li class="py-2">
                                <a class="nav-link read_more" href="#2">{{ 'Acceptance criteria' | t }}</a>
                            </li>
                            {% if show_limity_przyjec %}
