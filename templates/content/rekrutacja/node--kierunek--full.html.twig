                                            <a href="{{ item.uri }}">{{ item.title }}</a>
                                        </div>
                                    {% endfor %}
                                    </div>
                                {% endif %}
                        </div>
                        {% endif %}
                        {{ drupal_field('field_opis_kierunku', 'node', node.id, 'full') }}
                    </div>
                </div>
            </section>
            <section id="2" class="py-4 mt-4 border-top">
                <div class="row">
                    <div class="col-12">
                        <h2 class="underline">{{ 'Acceptance criteria' | t }}</h2>
                        {{ drupal_field('field_kryteria_przyjec', 'node', node.id, 'full') }}

{#                        {% if node.langcode.value == 'en' %}#}
