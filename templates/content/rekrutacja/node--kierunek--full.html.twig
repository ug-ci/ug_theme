                                <a class="nav-link read_more" href="#3">
                                    {{  'Student place limits' | t }}
                                </a>
                            </li>
                            {% endif %}
                            <li class=" py-2">
                                <a class="nav-link read_more" href="#4">{{ 'Necessary documents' | t }}</a>
                            </li>
                            {% if show_terminy_rekrutacji %}<li class=" py-2">
                                <a class="nav-link read_more" href="#5">{{ 'Deadlines' | t }}</a>
                            </li>{% endif %}
                            <li class=" py-2">
                                <a class="nav-link read_more" href="#6">{{ 'Fees' | t }}</a>
                            </li>
                            {% if show_raport_z_zakonczenia %}
