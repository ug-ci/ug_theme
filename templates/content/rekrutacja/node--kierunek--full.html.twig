{#                            <a href="{{ path('entity.taxonomy_term.canonical', {'taxonomy_term': node.field_wydzial.entity.tid.value}) }}">#}
                            {{ node.field_wydzial.entity.name.value }}
{#                            </a>#}
                        </p>

{#                        LINK DO IRK #}
                        <p class="col-md-6 fs-5">
                            <a class="btn btn-primary text-white btn-sm m-0" href="https://irk.ug.edu.pl">{{ 'Enroll' | t }}</a>
                        </p>
{#                        LINK DO IRK - END#}
                    </div>
                    <div class="col-md-5 p-0">
                        <img src="{{ node.field_ilustracja['0'].entity.uri.value | image_style('kierunek_1200x800') }}"
