{#                        {%  if field_limity_przyjec.value %}{{ drupal_field('field_limity_przyjec', 'node', node.id, 'full') }}<p>{% endif %}#}
                        {%  if node.field_uwagi.value %}{{ drupal_field('field_uwagi', 'node', node.id, 'full') }}{% endif %}

                    </div>
                </div>
            </section>
            {% endif %}
            <section id="4" class="py-4 mt-4 border-top">
