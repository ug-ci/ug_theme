                            </li>
                            {% endif %}
                        </ul>
                    </div>
                </div>
            </section>
            <section id="1" class="py-4 mt-4 border-top">
                <div class="row g-4">
                    <div class="col-12">
                        <h2 class="underline">{{ 'Description' | t }}</h2>
                    </div>
