{#
/**
 * @file
 * Default theme implementation to display a paragraph.
 *
 * Available variables:
 * - paragraph: Full paragraph entity.
 *   Only method names starting with "get", "has", or "is" and a few common
 *   methods such as "id", "label", and "bundle" are available. For example:
 *   - paragraph.getCreatedTime() will return the paragraph creation timestamp.
 *   - paragraph.id(): The paragraph ID.
 *   - paragraph.bundle(): The type of the paragraph, for example, "image" or "text".
 *   - paragraph.getOwnerId(): The user ID of the paragraph author.
 *   See Drupal\paragraphs\Entity\Paragraph for a full list of public properties
 *   and methods for the paragraph object.
 * - content: All paragraph items. Use {{ content }} to print them all,
 *   or print a subset such as {{ content.field_example }}. Use
 *   {{ content|without('field_example') }} to temporarily suppress the printing
 *   of a given child element.
 * - attributes: HTML attributes for the containing element.
 *   The attributes.class element may contain one or more of the following
 *   classes:
 *   - paragraphs: The current template type (also known as a "theming hook").
 *   - paragraphs--type-[type]: The current paragraphs type. For example, if the paragraph is an
 *     "Image" it would result in "paragraphs--type--image". Note that the machine
 *     name will often be in a short form of the human readable label.
 *   - paragraphs--view-mode--[view_mode]: The View Mode of the paragraph; for example, a
 *     preview would result in: "paragraphs--view-mode--preview", and
 *     default: "paragraphs--view-mode--default".
 * - view_mode: View mode; for example, "preview" or "full".
 * - logged_in: Flag for authenticated user status. Will be true when the
 *   current user is a logged-in member.
 * - is_admin: Flag for admin user status. Will be true when the current user
 *   is an administrator.
 *
 * @see template_preprocess_paragraph()
 *
 * @ingroup themeable
 */
#}
{%
    set classes = [
    'paragraph',
    'paragraph--type--' ~ paragraph.bundle|clean_class,
    view_mode ? 'paragraph--view-mode--' ~ view_mode|clean_class,
    not paragraph.isPublished() ? 'paragraph--unpublished',
    'pb-4'
]
%}
{% block paragraph %}
    <div{{ attributes.addClass(classes) }}>
        {% block content %}
{#            {{  kint()  }}#}

{#            {{  kint(content)  }}#}
{#            {{  kint(paragraph)  }}#}

            <h3>{{ paragraph.field_nazwa_rekrutacji.value }}</h3>
            <div class="alert alert-primary" role="alert">{{ paragraph.field_informacja_o_rekrutacji.value }}</div>
            <div class="container">
                <div class="row pt-2">
                    <div class="col-md-6">
                        {% if content.group_terminy_rekrutacji is not empty %}
                            <h4 class="pb-3">Terminy rekrutacji</h4>
{#                        {{ content.group_terminy_rekrutacji }}#}
                        {{ content.group_terminy_rekrutacji.field_zakonczenie_rejestracji }}
                        {{ content.group_terminy_rekrutacji.field_inny_termin_rekrutacji }}
                        {{ content.group_terminy_rekrutacji.field_ogl_listy_kandydatow }}
                        {{ content.group_terminy_rekrutacji.field_ogl_listy_osob_przyjetych }}
                        {{ content.group_terminy_rekrutacji.field_rozmowa_kwalifikacyjna }}

{#                        {% if paragraph.field_rozmowa_kwalifikacyjna.value is not empty %}#}
{#                            <p><strong>{{ paragraph.field_rozmowa_kwalifikacyjna.fieldDefinition.label }}</strong><br/>#}
{#                                {{ paragraph.field_rozmowa_kwalifikacyjna.value }}</p>#}
{#                        {% endif %}#}

{#                        {% if paragraph.field_ogl_listy_kandydatow.value is not empty %}#}
{#                            <p><strong>{{ paragraph.field_ogl_listy_kandydatow.fieldDefinition.label }}</strong><br/>#}
{#                                {{ paragraph.field_ogl_listy_kandydatow.value }}</p>#}
{#                        {% endif %}#}

{#                        {% if paragraph.field_ogl_listy_osob_przyjetych.value is not empty %}#}
{#                            <p><strong>{{ paragraph.field_ogl_listy_osob_przyjetych.fieldDefinition.label }}</strong><br/>#}
{#                                {{ paragraph.field_ogl_listy_osob_przyjetych.value | format_datetime('full', 'short', locale='pl') }}</p>#}
{#                                {{ paragraph.field_ogl_listy_osob_przyjetych.value | date("l, j. F Y - H:i") }}</p>#}
{#                        {% endif %}#}
                        {% endif %}
                    </div>
                    <div class="col-md-6">
                        {% if content.group_kontakt is not empty %}
                            <h4 class="pb-3">{{ 'Where to submit documents after the list of candidates has been announced' | t }}</h4>
{#                         AAAA#}
{#                            {{ content.group_kontakt }}#}
{#                            BBBB#}
                        <strong>{{ content.group_kontakt.field_kontakt_z_komisja }}</strong>
{#                        {{ kint(content.group_kontakt.field_miejsce_godz_urzedowania) }}#}
                        {{ content.group_kontakt.field_miejsce_godz_urzedowania }}

{#                        {{ content.group_kontakt.field_mapa_wydzialu }}#}
                        {% set adres = content.group_kontakt.field_mapa_wydzialu.0['#node'].field_adres_budynku %}
                        <div class="pt-3 pb-3">
{#                            {{ kint(adres) }}#}
                        {{ adres.address_line1 }}, {{ paragraph.field_nr_pokoju_komisji.value }}<br />
                        {{ adres.postal_code }} {{ adres.locality }}
                            <br/>
                            {% set budynek_nid = content.group_kontakt.field_mapa_wydzialu.0['#node'].nid.value %}
                            <a href="/node/{{ budynek_nid }}">{{ 'see on a detailed map' | t }}</a>
                        </div>

                        <a href="tel:{{ paragraph.field_miejsce_telefon.value |replace({' ': ''}) }}">tel: {{ paragraph.field_miejsce_telefon.value }}</a>
                        {{ content.group_kontakt.field_miejsce_e_mail }}
                        {{ content.group_kontakt.field_miejsce_fax }}
                        {% endif %}
                    </div>
                </div>
            </div>
        {% endblock %}
    </div>
{% endblock paragraph %}
