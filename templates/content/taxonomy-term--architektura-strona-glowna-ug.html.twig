{#
/**
 * @file
 * Theme override to display a taxonomy term.
 *
 * Available variables:
 * - url: URL of the current term.
 * - name: Name of the current term.
 * - content: Items for the content of the term (fields and description).
 *   Use 'content' to print them all, or print a subset such as
 *   'content.description'. Use the following code to exclude the
 *   printing of a given child element:
 *   @code
 *   {{ content|without('description') }}
 *   @endcode
 * - attributes: HTML attributes for the wrapper.
 * - page: Flag for the full page state.
 * - term: The taxonomy term entity, including:
 *   - id: The ID of the taxonomy term.
 *   - bundle: Machine name of the current vocabulary.
 * - view_mode: View mode, e.g. 'full', 'teaser', etc.
 *
 * @see template_preprocess_taxonomy_term()
 *
 * Kopia z: bootstrap_barrio/templates/content/taxonomy-term.html.twig
 *
 */
#}
{%
  set classes = [
    'taxonomy-term',
    'vocabulary-' ~ term.bundle|clean_class,
  ]
%}
<div{{ attributes.setAttribute('id', 'taxonomy-term-' ~ term.id).addClass(classes) }}>
  {{ title_prefix }}
  {% if not page %}
    <h2><a href="{{ url }}">{{ name }}</a></h2>
  {% endif %}
  {{ title_suffix }}
  <div class="content">
{#    {{ content }}#}


    {#
    p|Pełna treść stron (artykułów)
    t|Kafle - tytuły stron
    d|Kafle - poddziały (kategorie podrzędne)
    pt|Pierwszy artykuł + kafle: tytuły pozostałych stron
    one|Pierwszy artykuł bez tytułu + kafle: tytuły pozostałych stron
    one+d|Pierwszy artykuł bez tytułu + kafle: poddziały
    s|Podsumowania - lista tytułów i skrótów stron
    g|Lista galerii - miniaturka i tytuł strony
    #}
    {% if term.field_prezentacja.value == 'p' %}
      {# p|Pełna treść stron (artykułów) #}
      {{ drupal_view('prezentacja_w_kategorii', 'blok_pelna_tresc', tid) }}
    {% elseif term.field_prezentacja.value == 't' %}
      {# t|Kafle - tytuły stron #}
      {{ drupal_view('prezentacja_w_kategorii', 'blok_tytuly', tid) }}
    {% elseif term.field_prezentacja.value == 'd' %}
      {# d|Kafle - poddziały (kategorie podrzędne) #}
      {{ drupal_view('prezentacja_w_kategorii_terminy', 'blok_poddzialy', tid) }}
      {% elseif term.field_prezentacja.value == 'd+o' %}
        {# d|Kafle - poddziały z obrazkami #}
          {{ drupal_view('prezentacja_w_kategorii_terminy', 'blok_poddzialy_kafle', tid) }}
    {% elseif term.field_prezentacja.value == 'pt' %}
      {# pt|Pierwszy artykuł + kafle: tytuły pozostałych stron#}
      {{ drupal_view('prezentacja_w_kategorii', 'blok_pierwszy_artykul', tid) }}
      {{ drupal_view('prezentacja_w_kategorii', 'blok_tytuly_z_przesunieciem_o_1', tid) }}
    {% elseif term.field_prezentacja.value == 'one' %}
      {# one|Pierwszy artykuł bez tytułu + kafle: tytuły pozostałych stron #}
      {{ drupal_view('prezentacja_w_kategorii', 'block_article_no_title', tid) }}
      {{ drupal_view('prezentacja_w_kategorii', 'blok_tytuly_z_przesunieciem_o_1', tid) }}
    {% elseif term.field_prezentacja.value == 'one+d' %}
      {# one+d|pełna treśc pierwwszego artykułu + Prezentacja poddziałów #}
      {{ drupal_view('prezentacja_w_kategorii', 'block_article_no_title', tid) }}
      {{ drupal_view('prezentacja_w_kategorii_terminy', 'blok_poddzialy', tid) }}
    {% elseif term.field_prezentacja.value == 's' %}
      {# s|Podsumowania - lista tytułów i skrótów treści #}
      {{ drupal_view('prezentacja_w_kategorii', 'blok_skroty', tid) }}
    {% elseif term.field_prezentacja.value == 'g' %}
      {# g|Lista galerii - miniaturka i tytuł strony #}
      {{ drupal_view('prezentacja_w_kategorii', 'blok_galeria', tid) }}
    {% else %}
      {# brak prezentacji|Pełna treść artykułów #}
      {{ drupal_view('prezentacja_w_kategorii', 'blok_pelna_tresc', tid) }}
    {% endif %}
  </div>
</div>
