                    {% endif %}

                    {# termin składania dokumentów - wartosć brana z paragrafu #}
                    {% if node.field_sp_terminy.value is not empty %}{# terminy jako paragraph #}
                        <div class="px-3">
                            {% for termin in node.field_sp_terminy %}
