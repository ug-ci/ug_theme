                                {{ content.group_szczegoly.group_sp_rekrutacja.field_sp_dokumenty_miejsce }}
                            </div>
                        </div>
                    {% endif %}


                    {% if node.field_terminy_rekrutacji_podypl.value or node.field_sp_terminy.value %}
