                                {% endif %}
                            {% endfor %}
                        </div>

                    {% endif %}
                    {% if node.field_sp_dokumenty_miejsce.value is not empty %}{# stare pole #}
                        <div class="px-3">
                            <h4 class="fs-5 pt-1 pb-2">Miejsce składania dokumentów</h4>
