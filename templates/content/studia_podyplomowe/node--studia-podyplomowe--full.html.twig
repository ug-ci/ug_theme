                            <div class="px-2">
                                {{ content.group_szczegoly.group_sp_rekrutacja.field_terminy_rekrutacji_podypl }}
                            </div>
                        {% endif %}

                        {#                        {% if node.field_miejsce_skl_dokumentow.value is not empty %} #}
                        {#                            <h4 class="fs-5 pt-1 pb-2">Miejsce składania dokumentów</h4> #}
                        {#                            {{ content.group_szczegoly.group_sp_rekrutacja.field_miejsce_skl_dokumentow }} #}
                        {#                        {% endif %} #}
                    {% endif %}
                </dd>
            {% endif %}

