                            </div>
                            <div class="col-md-10">
                                <div class="card-body">
                                    <h5 class="card-title">Uwagi</h5>
                                    <div class="card-text">
                                        {{ content.group_dane_ogolne.field_uwagi }}
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            {% endif %}
