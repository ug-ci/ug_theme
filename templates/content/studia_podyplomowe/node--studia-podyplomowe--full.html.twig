                    {% if node.field_osoba_rekomendujaca.value %}
                        <div class="text-align-right font-italic">{{ content.group_szczegoly.group_sp_o_studiach.group_sp_rekomendacja.field_osoba_rekomendujaca }}</div>
                    {% endif %}

                    {#                {% if node.field_powiazanie_z_pracownikiem.value %} #}
                    {#                Osoba rekomendująca (pracownik UG) #}
                    {#                    <div class="text-align-right font-italic">{{ content.group_szczegoly.group_sp_o_studiach.group_sp_rekomendacja.field_powiazanie_z_pracownikiem }}</div> #}
