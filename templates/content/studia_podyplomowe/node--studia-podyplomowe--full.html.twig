                        <div class="card mb-3">
                            <div class="row no-gutters">
                                <div class="col-md-2 text-center p-4">
                                    <span class="symbol material-icons">how_to_reg</span>
                                </div>
                                <div class="col-md-10">
                                    <div class="card-body">
                                        <h5 class="card-title">Zarejestruj
                                            się!</h5>
                                        <p class="card-text">
                                            <a href="https://podyplomowi.irk.ug.edu.pl">Internetowa
                                                Rejestracja Kandydatów</a>
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                {% endif %}
            {% endif %}

